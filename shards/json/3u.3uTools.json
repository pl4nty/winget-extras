{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.3u.com/",
		"regex": "3uTools_v(\\d+\\.\\d+\\.\\d+)_Setup_x64\\.exe"
	},
	"urls": [
		"https://dl.3u.com/update/v900/dl/3uTools_v{version}_Setup_x64.exe",
		"https://dl.3u.com/update/v900/dl/3uTools_v{version}_Setup_x86.exe"
	]
}
