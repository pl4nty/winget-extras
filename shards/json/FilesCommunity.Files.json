{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://files.community/download",
		"regex": "Version (\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		"https://cdn.files.community/files/stable/Files.Package_{version}_Test/Files.Package_{version}_x64_arm64.msixbundle"
	]
}
