{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://github.com/microsoft/fluentui-system-icons/tags.atom",
		"regex": "releases/tag/(\\d+(?:\\.\\d+)+)\""
	},
	"urls": [
		"https://github.com/microsoft/fluentui-system-icons/raw/refs/tags/{version}/fonts/FluentSystemIcons-Light.ttf"
	]
}
