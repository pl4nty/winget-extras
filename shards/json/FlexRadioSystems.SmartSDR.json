{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://www.flexradio.com/software/",
		"regex": "SmartSDR v(\\d+(?:\\.\\d+)+)"
	},
	"urls": [
		{ "url": "https://smartsdr.flexradio.com/SmartSDR_v{version}_x64.msi", "architecture": "x64" },
		{
			"url": "https://smartsdr.flexradio.com/SmartSDR_v{version}_arm64.msi",
			"architecture": "arm64"
		}
	]
}
