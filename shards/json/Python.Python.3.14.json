{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.python.org/downloads/windows/",
		"regex": "python-(3\\.14\\.\\d+)-amd64\\.exe"
	},
	"urls": [
		"https://www.python.org/ftp/python/{version}/python-{version}.exe",
		"https://www.python.org/ftp/python/{version}/python-{version}-amd64.exe",
		"https://www.python.org/ftp/python/{version}/python-{version}-arm64.exe"
	],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://docs.python.org/release/{version}/whatsnew/changelog.html",
		"releaseNotesUrl": "https://docs.python.org/release/{version}/whatsnew/changelog.html",
		"characterLimit": 5000
	}
}
