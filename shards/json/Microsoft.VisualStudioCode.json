{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "json",
	"json": {
		"url": "https://update.code.visualstudio.com/api/update/win32-x64-user/stable/latest",
		"path": "productVersion"
	},
	"urls": [
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{data.version}/VSCodeUserSetup-x64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{data.version}/VSCodeSetup-x64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{data.version}/VSCode-win32-x64-{version}.zip",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{data.version}/VSCodeUserSetup-arm64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{data.version}/VSCodeSetup-arm64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{data.version}/VSCode-win32-arm64-{version}.zip"
	]
}
