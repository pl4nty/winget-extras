{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://api.github.com/repos/worproject/dldserv-mirror/releases/latest",
		"regex": "\"tag_name\":\"(?<tag>[^\"]+)\"[\\s\\S]*?\"name\":\"WoR-Boot-Mounter_Release_(?<version>\\d+(?:\\.\\d+)+)\\.zip\""
	},
	"urls": [
		"https://github.com/worproject/dldserv-mirror/releases/download/{captures.tag|/|%2F}/WoR-Boot-Mounter_Release_{version}.zip"
	]
}
