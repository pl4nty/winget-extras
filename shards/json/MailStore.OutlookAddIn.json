{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://my.mailstore.com/downloads/",
		"regex": "\"version\":\\s*\"(?<version>\\d+(?:\\.\\d+){2})\\.(?<build>\\d+)\",\\s*\"product\":\\s*\"OutlookAddin\"(?![\\s\\S]*\"product\":\\s*\"OutlookAddin\")"
	},
	"urls": [
		"https://download.mailstore.com/dont-link-this/36B44217-2BF0-4603-8160-35DF2A708DC3/{version}.{captures.build}/MailStoreOutlookAddinSetup-{version}.{captures.build}.msi"
	]
}
