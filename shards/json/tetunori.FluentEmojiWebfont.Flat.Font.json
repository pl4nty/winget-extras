{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://github.com/tetunori/fluent-emoji-webfont/tags.atom",
		"regex": "releases/tag/v(\\d+(?:\\.\\d+)+)\""
	},
	"urls": [
		"https://github.com/tetunori/fluent-emoji-webfont/raw/refs/tags/v{version}/dist/FluentEmojiFlat.ttf"
	]
}
