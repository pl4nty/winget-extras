{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://api.nuget.org/v3-flatcontainer/runtime.win10-x64.microsoft.net.native.sharedlibrary/index.json",
		"regex": "\"(2\\.1\\.\\d+)\""
	},
	"version": {
		"source": "display"
	},
	"state": {
		"source": "value",
		"value": "{version}"
	},
	"urls": [
		"https://globalcdn.nuget.org/packages/runtime.win10-x64.microsoft.net.native.sharedlibrary.{version}.nupkg",
		"https://globalcdn.nuget.org/packages/runtime.win10-x86.microsoft.net.native.sharedlibrary.{version}.nupkg",
		"https://globalcdn.nuget.org/packages/runtime.win10-arm.microsoft.net.native.sharedlibrary.{version}.nupkg"
	]
}
