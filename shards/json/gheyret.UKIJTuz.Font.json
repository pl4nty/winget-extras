{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "gheyret",
		"repo": "UyghurEditPP"
	},
	"version": {
		"source": "fontVersion"
	},
	"urls": [
		{
			"url": "https://github.com/gheyret/UyghurEditPP/releases/download/{github.rawTag}/UyghurEditPP.zip",
			"nestedInstallerMatches": ["UyghurEditPP/UKIJTuz"]
		}
	],
	"state": {
		"source": "value",
		"value": "{github.version}"
	}
}
