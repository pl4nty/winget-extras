{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.dialux.com/en-GB/download",
		"regex": "Version</span></small><br><small><span class=\"dial-grey-ii\">(?<version>\\d+\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.\\d+)"
	},
	"urls": [
		{
			"url": "https://cdn.dialux.com/evo/DIALux_evo_{captures.minor}_{captures.patch}.exe",
			"architecture": "x64"
		}
	]
}
