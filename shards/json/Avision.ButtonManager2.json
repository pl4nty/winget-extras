{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.avision.com/eu/shop/flatbed-scanner/fb5000/",
		"regex": "ButtonManager V2</td><td>V(?<version>\\d+(?:\\.\\d+)+)</td>[\\s\\S]*?download-manager-files/(?<file>BM2_V\\d+_\\d{8}\\.zip)"
	},
	"urls": [
		{
			"url": "https://www.avision.com/eu/wp-content/uploads/sites/5/download-manager-files/{captures.file}",
			"nestedInstallerMatches": [
				"Setup.exe"
			]
		}
	]
}
