{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "DualSenseClient",
		"repo": "DualSenseClient",
		"method": "api-list",
		"kind": "prerelease",
		"tagRegex": "\\.[0-9a-f]{7,}$"
