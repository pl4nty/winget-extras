{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.avision.com/eu/shop/flatbed-scanner/fb5000/",
		"regex": "download-manager-files/(?<file>AVScanX_V(?<version>\\d+(?:\\.\\d+){3})\\.\\d{8}\\.zip)"
	},
	"urls": [
		{
			"url": "https://www.avision.com/eu/wp-content/uploads/sites/5/download-manager-files/{captures.file}",
			"nestedInstallerMatches": ["setup.exe"]
		}
	]
}
