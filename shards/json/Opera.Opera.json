{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://download.opera.com/download/get/?partner=www&opsys=Windows&arch=x64&nothanks=yes"
		],
		"regex": "/desktop/(?<version>\\d+(?:\\.\\d+)+)/win/"
	},
	"urls": [
		"https://get.geo.opera.com/pub/opera/desktop/{version}/win/Opera_{version}_Setup.exe",
		"https://get.geo.opera.com/pub/opera/desktop/{version}/win/Opera_{version}_Setup_x64.exe",
		"https://get.geo.opera.com/pub/opera/desktop/{version}/win/Opera_{version}_Setup_arm64.exe"
	]
}
