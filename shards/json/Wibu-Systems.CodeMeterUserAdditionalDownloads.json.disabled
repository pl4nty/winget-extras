// Disabled: WIBU-SYSTEMS AG's download endpoint returns 403 Forbidden for requests
// from GitHub's Linux ARM Actions runners (confirmed reproducible), even though the
// same URL succeeds from Windows runners and real winget clients. This would make the
// scheduled Update Packages workflow fail every run. Re-enable once that's resolved.

{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.wibu.com/support/user/user-software.html",
		"regex": "<option value=\"(?<id>\\d+)\"[^>]*>Version (?<version>\\d+(?:\\.\\d+)+) \\| CmDust \\|"
	},
	"version": { "source": "product" },
	"urls": [
		"https://www.wibu.com/support/user/user-software/file/download/{captures.id}.html?tx_wibudownloads_downloadlist%5BdirectDownload%5D=directDownload"
	]
}
