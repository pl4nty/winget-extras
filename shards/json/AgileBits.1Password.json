{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://c.1password.com/dist/1P/win8/1PasswordSetup-latest.appinstaller",
		"regex": "<MainBundle [^>]*Version=\"(?<version>(?<base>\\d+\\.\\d+\\.\\d+)\\.\\d+)\""
	},
	"urls": [
		"https://c.1password.com/dist/1P/win8/1PasswordSetup-{captures.base}.msixbundle",
		"https://c.1password.com/dist/1P/win8/1PasswordSetup-{captures.base}.msi"
	]
}
