{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.goodsync.com/news-windows",
		"regex": "Version (?<version>(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)) --"
	},
	"version": "{captures.major}.{captures.minor}.{captures.patch}.{captures.patch}",
	"urls": ["https://services.goodsync.com/download/GoodSync-vsub-WD-Setup.exe"]
}
