{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.keil.com/demo/eval/arm.htm",
		"regex": "Version (?<version>(?<major>\\d+)\\.(?<minor>\\d+)(?<suffix>[a-z]?)) Evaluation Software"
	},
	"version": { "source": "product" },
	"state": { "source": "value", "value": "{captures.major}.{captures.minor}{captures.suffix}" },
	"urls": [
		"https://www.keil.com/files/eval/mdk{captures.major}{captures.minor}{captures.suffix}.exe"
	]
}
