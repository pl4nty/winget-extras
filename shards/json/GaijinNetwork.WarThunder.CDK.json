{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://wiki.warthunder.com/index.php?title=Download_War_Thunder_CDK",
		"regex": "href=\"(?<url>https://cdk\\.warthunder\\.com/WarThunderCDK_[0-9a-f]+_(?<version>\\d{4})_(?<month>\\d{2})_(?<day>\\d{2})__(?<hour>\\d{2})_(?<minute>\\d{2})\\.exe)\""
	},
	"version": "{version}.{captures.month}.{captures.day}.{captures.hour}.{captures.minute}",
	"urls": ["{captures.url}"]
}
