{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-commit",
	"github": {
		"owner": "googlefonts",
		"repo": "tinos",
		"path": "fonts/otf"
	},
	"version": { "source": "fontVersion" },
	"urls": [
		{
			"url": "https://github.com/googlefonts/tinos/archive/{github.commit}.zip",
			"nestedInstallerMatches": ["fonts/otf/Tinos-"]
		}
	],
	"state": { "source": "value", "value": "{github.commit}" }
}
