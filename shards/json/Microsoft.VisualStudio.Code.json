{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://update.code.visualstudio.com/api/update/win32-x64-user/stable/latest",
		"regex": "\"version\":\"(?<commit>[0-9a-f]{40})\",\"productVersion\":\"(?<version>\\d+\\.\\d+\\.\\d+)\""
	},
	"urls": [
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{captures.commit}/VSCodeUserSetup-x64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{captures.commit}/VSCodeSetup-x64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{captures.commit}/VSCode-win32-x64-{version}.zip",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{captures.commit}/VSCodeUserSetup-arm64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{captures.commit}/VSCodeSetup-arm64-{version}.exe",
		"https://vscode.download.prss.microsoft.com/dbazure/download/stable/{captures.commit}/VSCode-win32-arm64-{version}.zip"
	]
}
