{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "json",
	"json": {
		"url": "https://config.teams.microsoft.com/config/v1/MicrosoftTeams/49_1.0.0.0?environment=prod&agents=TeamsBuilds",
		"path": "TeamsBuilds.BuildSettings.WebView2PreAuth.x64.latestVersion"
	},
	"version": { "source": "display" },
	"urls": [
		{
			"url": "https://teamsinstaller.public.onecdn.static.microsoft/production-windows-x86/{version}/MSTeams-x86.msix",
			"nestedInstallerMatches": ["MicrosoftTeamsMeetingAddinInstallerX86.msi"]
		},
		{
			"url": "https://teamsinstaller.public.onecdn.static.microsoft/production-windows-x64/{version}/MSTeams-x64.msix",
			"nestedInstallerMatches": ["MicrosoftTeamsMeetingAddinInstaller.msi"]
		}
	],
	"state": {
		"source": "value",
		"value": "{version}"
	}
}
