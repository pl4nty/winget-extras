{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-commit",
	"github": {
		"owner": "iaolo",
		"repo": "iA-Fonts",
		"path": "iA Writer Mono"
	},
	"version": { "source": "fontVersion" },
	"urls": [
		{
			"url": "https://github.com/iaolo/iA-Fonts/archive/{github.commit}.zip",
			"nestedInstallerMatches": ["iA Writer Mono/"]
		}
	],
	"state": { "source": "value", "value": "{github.commit}" }
}
