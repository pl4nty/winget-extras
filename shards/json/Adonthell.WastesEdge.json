{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://download.savannah.gnu.org/releases/adonthell/",
		"regex": "wastesedge-(\\d+(?:\\.\\d+)+)-x64\\.msi\""
	},
	"urls": [
		"https://download.savannah.gnu.org/releases/adonthell/wastesedge-{version}-x64.msi",
		"https://download.savannah.gnu.org/releases/adonthell/wastesedge-{version}-x86.msi"
	]
}
