{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://api.nuget.org/v3-flatcontainer/microsoft.net.native.sharedlibrary-x64/index.json",
		"regex": "\"(1\\.6\\.\\d+)\""
	},
	"version": {
		"source": "display"
	},
	"state": {
		"source": "value",
		"value": "{version}"
	},
	"urls": [
		"https://globalcdn.nuget.org/packages/microsoft.net.native.sharedlibrary-x64.{version}.nupkg",
		"https://globalcdn.nuget.org/packages/microsoft.net.native.sharedlibrary-x86.{version}.nupkg",
		"https://globalcdn.nuget.org/packages/microsoft.net.native.sharedlibrary-arm.{version}.nupkg"
	]
}
